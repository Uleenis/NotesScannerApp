# Copy to .env.local (ignored by git) and fill in. Only the project URL and the publishable key belong here, never a secret key.
# For the local database, use the address of this computer on the local network (not localhost) so the phone can reach it.
# The publishable key is printed by: npx supabase status
EXPO_PUBLIC_SUPABASE_URL=http://192.168.0.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
