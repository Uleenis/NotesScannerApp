{
  "name": "notesscannerapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:test:concurrency": "bash supabase/tests/concurrency/charge-page.sh && bash supabase/tests/concurrency/relaunch-pages.sh && bash supabase/tests/concurrency/transfer-account.sh && bash supabase/tests/concurrency/library-race.sh && bash supabase/tests/concurrency/corrections-race.sh && bash supabase/tests/concurrency/edit-race.sh && bash supabase/tests/concurrency/lexicon-race.sh",
    "functions:test": "deno test --node-modules-dir=none --allow-env --allow-net --permit-no-files supabase/functions",
    "functions:check": "deno check --node-modules-dir=none \"supabase/functions/**/*.ts\"",
    "functions:lint": "deno lint --rules-exclude=no-import-prefix supabase/functions",
    "audit": "audit-ci --config audit-ci.json",
    "service:build": "docker build --target runtime --tag notes-reading:local services/reading",
    "service:test": "docker build --target check --tag notes-reading:check services/reading && docker run --rm notes-reading:check sh check.sh",
    "service:start": "docker compose --file services/reading/compose.yaml up --build --detach --wait",
    "service:stop": "docker compose --file services/reading/compose.yaml down"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "audit-ci": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
